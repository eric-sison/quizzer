# Copy to .env.local. Values below match docker-compose.yml.

# apps/api MUST serve port 3000: the desktop client pins its backend origin at
# compile time and defaults to http://localhost:3000. apps/web uses 3001.
PORT=3000

# Origin baked into every published quiz link. Never derived from a request
# host - a link minted on the wrong origin is rejected offline by the client.
PUBLIC_API_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://quizzer:quizzer@localhost:5433/quizzer

# Shared secret apps/web presents on server-to-server calls. Placeholder until
# real teacher auth lands.
SERVICE_TOKEN=dev-service-token-change-me

# Signs exam session JWTs handed to the desktop client. MUST stay distinct from
# any teacher/service credential: an exam token must never authorize teacher
# endpoints.
EXAM_JWT_SECRET=dev-exam-jwt-secret-change-me-please
