# Copy to .env.local. Values below match docker-compose.yml.

# apps/api MUST serve port 3000: the desktop client pins its backend origin at
# compile time and defaults to http://localhost:3000. apps/web uses 3001.
PORT=3000

# Origin baked into every published quiz link. Never derived from a request
# host - a link minted on the wrong origin is rejected offline by the client.
PUBLIC_API_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://quizzer:quizzer@localhost:5433/quizzer

# Shared secret apps/web presents on server-to-server calls. Placeholder until
# real teacher auth lands.
SERVICE_TOKEN=dev-service-token-change-me

# Signs exam session JWTs handed to the desktop client. MUST stay distinct from
# any teacher/service credential: an exam token must never authorize teacher
# endpoints.
EXAM_JWT_SECRET=dev-exam-jwt-secret-change-me-please

# Better Auth (Google sign-in). BETTER_AUTH_SECRET is the third credential
# class and must differ from both secrets above; the API refuses to boot
# otherwise. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-32ch

# Where apps/web is served. Google's OAuth redirect URI lives on this origin
# (<PUBLIC_WEB_ORIGIN>/api/auth/callback/google) and browsers reach Better Auth
# through the web app's rewrite - never on this API's origin directly.
PUBLIC_WEB_ORIGIN=http://localhost:3001

# From Google Cloud console (APIs & Services > Credentials > OAuth client).
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Garage (S3-compatible) question-image storage. Values match docker-compose.yml
# and infra/garage/init.sh, which provisions the bucket and this key:
#
#   docker compose up -d && ./infra/garage/init.sh
#
# Only apps/api talks to Garage; nothing else needs these.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=quizzer-media
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=9086f2e2367a4f5c7f89ac35bcb541b1f4ba1041c352c9d5e02e28de0a166d9a
