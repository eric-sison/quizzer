{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // This app emits nothing, and declaration mode would reject Better Auth's
    // inferred instance type as non-portable under pnpm (TS2742).
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules", "drizzle"]
}
