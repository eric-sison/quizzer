# Copy to .env.local.

# Where apps/api listens. Must match the origin the desktop client pins, which
# is also where published quiz links point.
API_ORIGIN=http://localhost:3000

# Must equal SERVICE_TOKEN in apps/api/.env.local. Server-only: never rename
# this to NEXT_PUBLIC_*, or it ships in the browser bundle.
SERVICE_TOKEN=dev-service-token-change-me
