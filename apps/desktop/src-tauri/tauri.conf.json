{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quizzer Exam",
  "version": "0.1.0",
  "identifier": "com.ericsison.quizzer.exam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Quizzer Exam",
        "width": 1280,
        "height": 800,
        "center": true,
        "fullscreen": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true,
        "focus": true,
        "visible": true,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "dragDropEnabled": false,
        "incognito": true,
        "visibleOnAllWorkspaces": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "child-src": "'none'",
        "worker-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: http://localhost:1420",
        "font-src": "'self' data: http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "publisher": "Quizzer",
    "shortDescription": "Secure exam client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
