{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["API_ORIGIN", "SERVICE_TOKEN", "PUBLIC_API_ORIGIN", "PUBLIC_WEB_ORIGIN", "DATABASE_URL", "EXAM_JWT_SECRET", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "PORT", "NODE_ENV", "TAURI_DEV_HOST"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["API_ORIGIN", "SERVICE_TOKEN", "PUBLIC_API_ORIGIN", "PUBLIC_WEB_ORIGIN", "DATABASE_URL", "EXAM_JWT_SECRET", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "PORT", "NODE_ENV", "TAURI_DEV_HOST"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "env": ["API_ORIGIN", "SERVICE_TOKEN", "PUBLIC_API_ORIGIN", "PUBLIC_WEB_ORIGIN", "DATABASE_URL", "EXAM_JWT_SECRET", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "PORT", "NODE_ENV", "TAURI_DEV_HOST"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
